# indexer/.env 로 복사해 채운다. .env 는 커밋하지 않는다.

# Neon DB 소유자 연결 문자열. `indexer db migrate`·`db login`·이 값으로 돈다.
# 블로그와 같은 Neon 데이터베이스다. 색인은 search 스키마에만 들어간다.
SEARCH_OWNER_URL=

# `indexer db login search_writer` / `search_reader` 가 채운다. 직접 넣지 않는다.
SEARCH_WRITER_URL=
SEARCH_READER_URL=

# Gemini API 키. https://aistudio.google.com/apikey 에서 발급한다(카드 등록 없는 무료 티어).
GEMINI_API_KEY=
