# services/search/.env 로 복사해 채운다. .env 는 커밋하지 않는다. 배포본은 Vercel 환경 변수로 넣는다.

# Neon 읽기 계정 연결 문자열. indexer/.env 의 SEARCH_READER_URL 과 같은 값이다.
SEARCH_READER_URL=

# Gemini API 키. indexer/.env 와 같은 값을 쓴다.
GEMINI_API_KEY=

# 공유 키. 블로그 서버(3b)와 이 서비스만 갖는다. 아무 긴 난수면 된다.
SEARCH_API_KEY=

# 공급자 대기 상한(초). 기본 1.5. 0 이면 언제나 키워드로 강등된다(강등 확인용).
# SEARCH_EMBED_TIMEOUT_S=1.5
